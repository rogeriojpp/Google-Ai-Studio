<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Segurança no Preço Certo — Gestão de O.S.</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0b1120;
      color: #f8fafc;
      -webkit-tap-highlight-color: transparent;
      overscroll-behavior-y: contain;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.25s ease-out forwards;
    }
    /* Ocultar barra de rolagem nos filtros horizontais */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* Previne scroll da página enquanto assina no canvas */
    canvas.signature-pad {
      touch-action: none;
    }
  </style>
</head>
<body class="min-h-screen bg-[#0b1120] text-slate-50 selection:bg-blue-600 selection:text-white">

  <!-- =====================================================================
       1. TELA DE LOGIN
       ===================================================================== -->
  <section id="login-view" class="min-h-screen flex flex-col justify-center items-center p-4 bg-gradient-to-b from-slate-950 via-[#0b1120] to-slate-900">
    <div class="w-full max-w-md animate-fade-in">
      <!-- Logo / Cabeçalho -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-[#2563eb]/20 border border-[#2563eb]/40 text-blue-400 mb-3 shadow-lg shadow-blue-950/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white">Segurança no Preço Certo</h1>
        <p class="text-sm text-slate-400 mt-1">Sistema de Ordens de Serviço</p>
      </div>

      <!-- Card de Login -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-6 shadow-2xl">
        <!-- Botões de 1 toque -->
        <div class="mb-5">
          <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
            Acesso Rápido (1 Toque)
          </span>
          <div class="grid grid-cols-2 gap-2 p-1 bg-[#0b1120] rounded-xl border border-slate-800">
            <button type="button" id="btn-role-tech" onclick="selecionarPerfil('tecnico')"
              class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all bg-[#2563eb] text-white shadow">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              Técnico
            </button>
            <button type="button" id="btn-role-admin" onclick="selecionarPerfil('admin')"
              class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all text-slate-400 hover:text-white">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Administrador
            </button>
          </div>
        </div>

        <!-- Alerta de Erro -->
        <div id="login-error" class="hidden mb-4 p-3 rounded-xl bg-red-500/15 border border-red-500/30 text-red-300 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span id="login-error-msg">Preencha usuário e senha.</span>
        </div>

        <form onsubmit="fazerLogin(event)" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Usuário / Operador</label>
            <input type="text" id="login-user" required
              class="w-full px-4 py-3.5 bg-[#0b1120] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-[#2563eb] text-base"
              value="Carlos Técnico" placeholder="Nome ou e-mail" />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Senha</label>
            <div class="relative">
              <input type="password" id="login-pass" required
                class="w-full px-4 pr-12 py-3.5 bg-[#0b1120] border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-[#2563eb] text-base"
                value="123456" placeholder="••••••••" />
              <button type="button" onclick="toggleSenha()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-white">
                <svg id="icon-eye" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
            </div>
          </div>

          <button type="submit"
            class="w-full py-4 px-4 mt-2 bg-[#2563eb] hover:bg-blue-500 active:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/25 transition-all flex items-center justify-center gap-2 text-base">
            <span>Entrar no Sistema</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       2. PAINEL PRINCIPAL (APP SHELL)
       ===================================================================== -->
  <section id="app-view" class="hidden min-h-screen pb-24">
    
    <!-- Cabeçalho Fixo -->
    <header class="sticky top-0 z-30 bg-[#111827]/95 backdrop-blur-md border-b border-slate-800 px-4 py-3">
      <div class="max-w-2xl mx-auto flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-xl bg-[#2563eb] flex items-center justify-center text-white shrink-0 shadow-md shadow-blue-600/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="min-w-0">
            <h1 class="text-base font-bold text-white truncate leading-tight">Segurança no Preço Certo</h1>
            <div class="flex items-center gap-2 mt-0.5">
              <span id="header-user-name" class="text-xs text-slate-300 truncate">Carlos Técnico</span>
              <span id="header-user-badge" class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-400 border border-blue-500/30">Técnico</span>
            </div>
          </div>
        </div>

        <button type="button" onclick="sairApp()" title="Sair do Sistema"
          class="p-2.5 rounded-xl bg-[#1e293b] hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/80 transition-colors flex items-center gap-1.5 text-xs font-semibold shrink-0">
          <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Sair</span>
        </button>
      </div>
    </header>

    <!-- Conteúdo Principal -->
    <main class="max-w-2xl mx-auto px-4 pt-4 space-y-4">
      
      <!-- Resumo Rápido (4 Cards Compactos) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <div class="bg-[#111827] border border-slate-800/90 rounded-xl p-3">
          <span class="text-xs text-slate-400 block">Abertas</span>
          <span id="stat-abertas" class="text-xl font-bold text-amber-400 mt-0.5 block">0</span>
        </div>
        <div class="bg-[#111827] border border-slate-800/90 rounded-xl p-3">
          <span class="text-xs text-slate-400 block">Em Andamento</span>
          <span id="stat-andamento" class="text-xl font-bold text-blue-400 mt-0.5 block">0</span>
        </div>
        <div class="bg-[#111827] border border-slate-800/90 rounded-xl p-3">
          <span class="text-xs text-slate-400 block">Concluídas</span>
          <span id="stat-concluidas" class="text-xl font-bold text-[#10b981] mt-0.5 block">0</span>
        </div>
        <div class="bg-[#111827] border border-slate-800/90 rounded-xl p-3">
          <span class="text-xs text-slate-400 block">Faturamento</span>
          <span id="stat-faturamento" class="text-lg font-bold text-white mt-0.5 block truncate">R$ 0,00</span>
        </div>
      </div>

      <!-- Botão Principal: Nova Ordem de Serviço -->
      <button type="button" onclick="abrirModalNovaOS()"
        class="w-full py-3.5 px-4 bg-[#2563eb] hover:bg-blue-500 active:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-600/20 transition-all flex items-center justify-center gap-2 text-base">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
        <span>+ Nova Ordem de Serviço</span>
      </button>

      <!-- Busca e Filtros em Pílulas -->
      <div class="space-y-2.5">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input type="text" id="search-input" oninput="renderizarListaOS()"
            class="w-full pl-10 pr-4 py-3 bg-[#111827] border border-slate-800 rounded-xl text-sm text-white placeholder-slate-400 focus:outline-none focus:border-[#2563eb]"
            placeholder="Buscar cliente, código, telefone ou equipamento..." />
        </div>

        <!-- Pílulas de Filtro -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
          <button type="button" onclick="setFiltroStatus('Todas')" data-filter="Todas"
            class="filter-pill px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-[#2563eb] text-white">
            Todas
          </button>
          <button type="button" onclick="setFiltroStatus('Aberta')" data-filter="Aberta"
            class="filter-pill px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-[#1e293b] text-slate-300 hover:bg-slate-700">
            Abertas
          </button>
          <button type="button" onclick="setFiltroStatus('Em Andamento')" data-filter="Em Andamento"
            class="filter-pill px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-[#1e293b] text-slate-300 hover:bg-slate-700">
            Em Andamento
          </button>
          <button type="button" onclick="setFiltroStatus('Concluída')" data-filter="Concluída"
            class="filter-pill px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-[#1e293b] text-slate-300 hover:bg-slate-700">
            Concluídas
          </button>
        </div>
      </div>

      <!-- Lista de Cards de O.S. -->
      <div id="os-list-container" class="space-y-3">
        <!-- Preenchido via JS -->
      </div>

    </main>
  </section>

  <!-- =====================================================================
       3. MODAL / TELA DE CRIAÇÃO E EDIÇÃO DE O.S. (FULLSCREEN MOBILE)
       ===================================================================== -->
  <div id="os-modal" class="hidden fixed inset-0 z-50 bg-[#0b1120] overflow-y-auto animate-fade-in">
    <!-- Barra Superior do Modal -->
    <div class="sticky top-0 z-20 bg-[#111827]/95 backdrop-blur-md border-b border-slate-800 px-4 py-3">
      <div class="max-w-2xl mx-auto flex items-center justify-between">
        <button type="button" onclick="fecharModalOS()" class="flex items-center gap-1.5 text-slate-300 hover:text-white py-1.5 px-2 rounded-lg active:bg-slate-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span class="text-sm font-semibold">Voltar</span>
        </button>
        <h2 id="modal-title" class="text-base font-bold text-white">Nova Ordem de Serviço</h2>
        <button type="button" id="btn-delete-os" onclick="confirmarExclusao()" class="hidden p-2 rounded-lg bg-red-500/15 text-red-400 hover:bg-red-500/25">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Caixa de Confirmação de Exclusão Inline (Sem confirm() nativo) -->
    <div id="delete-confirm-box" class="hidden max-w-2xl mx-auto mx-4 mt-4 p-4 rounded-xl bg-red-950/80 border border-red-500/40 text-center space-y-3">
      <p class="text-sm font-medium text-red-200">Tem certeza que deseja excluir esta Ordem de Serviço permanentemente?</p>
      <div class="flex gap-2 justify-center">
        <button type="button" onclick="cancelarExclusao()" class="px-4 py-2 rounded-lg bg-slate-800 text-slate-200 text-xs font-semibold">Cancelar</button>
        <button type="button" onclick="executarExclusao()" class="px-4 py-2 rounded-lg bg-red-600 text-white text-xs font-bold">Sim, Excluir O.S.</button>
      </div>
    </div>

    <!-- Formulário Completo -->
    <form id="os-form" onsubmit="salvarOS(event)" class="max-w-2xl mx-auto p-4 space-y-5 pb-28">
      <input type="hidden" id="os-id" />

      <!-- Status Rápido (Aparece na Edição ou Criação) -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-4 space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Status do Atendimento</label>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="selecionarStatusModal('Aberta')" data-modal-status="Aberta"
            class="modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center">
            Aberta
          </button>
          <button type="button" onclick="selecionarStatusModal('Em Andamento')" data-modal-status="Em Andamento"
            class="modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center">
            Em Andamento
          </button>
          <button type="button" onclick="selecionarStatusModal('Concluída')" data-modal-status="Concluída"
            class="modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center">
            Concluída
          </button>
        </div>
      </div>

      <!-- Dados do Cliente e Equipamento -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-4 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Dados do Cliente & Sistema</h3>
        
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Cliente / Condomínio *</label>
          <input type="text" id="os-cliente" required
            class="w-full px-3.5 py-3 bg-[#0b1120] border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:border-[#2563eb]"
            placeholder="Ex: Condomínio Residencial Alvorada" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Telefone / WhatsApp</label>
            <input type="tel" id="os-telefone"
              class="w-full px-3.5 py-3 bg-[#0b1120] border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:border-[#2563eb]"
              placeholder="(61) 99999-0000" />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Subsistema *</label>
            <select id="os-subsistema"
              class="w-full px-3.5 py-3 bg-[#0b1120] border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:border-[#2563eb]">
              <option value="CFTV (Câmeras / DVR)">CFTV (Câmeras / DVR)</option>
              <option value="Controle de Acesso">Controle de Acesso</option>
              <option value="Automatizador de Portão">Automatizador de Portão</option>
              <option value="Alarme / Cerca Elétrica">Alarme / Cerca Elétrica</option>
              <option value="Interfonia / Intelbras">Interfonia / Intelbras</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Defeito Relatado / Serviço Executado *</label>
          <textarea id="os-descricao" rows="3" required
            class="w-full px-3.5 py-3 bg-[#0b1120] border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:border-[#2563eb]"
            placeholder="Descreva o problema encontrado ou a manutenção realizada..."></textarea>
        </div>
      </div>

      <!-- Peças, Equipamentos e Mão de Obra -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Peças & Serviços</h3>
          <button type="button" onclick="adicionarItemOS()"
            class="px-3 py-1.5 rounded-lg bg-[#2563eb]/20 hover:bg-[#2563eb]/30 text-blue-400 border border-[#2563eb]/40 text-xs font-bold flex items-center gap-1">
            <span>+ Adicionar Item</span>
          </button>
        </div>

        <div id="os-itens-list" class="space-y-2.5">
          <!-- Itens dinâmicos -->
        </div>

        <div class="pt-3 border-t border-slate-800 flex items-center justify-between">
          <span class="text-sm font-medium text-slate-400">Valor Total da O.S.:</span>
          <span id="os-total-display" class="text-xl font-bold text-[#10b981]">R$ 0,00</span>
        </div>
      </div>

      <!-- Assinatura Digital Touchscreen -->
      <div class="bg-[#111827] border border-slate-800 rounded-2xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Assinatura do Cliente / Responsável</h3>
            <p class="text-[11px] text-slate-500">Assine com o dedo na área abaixo</p>
          </div>
          <button type="button" onclick="limparAssinatura()"
            class="px-3 py-1.5 rounded-lg bg-[#1e293b] hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700">
            Limpar
          </button>
        </div>

        <div class="relative w-full h-36 bg-[#0b1120] border-2 border-dashed border-slate-700 rounded-xl overflow-hidden">
          <canvas id="signature-canvas" class="signature-pad w-full h-full block cursor-crosshair"></canvas>
          <div id="signature-placeholder" class="pointer-events-none absolute inset-0 flex items-center justify-center text-xs text-slate-600">
            Toque e arraste para assinar
          </div>
        </div>
      </div>

      <!-- Barra Inferior Fixa de Salvar -->
      <div class="fixed bottom-0 left-0 right-0 bg-[#111827]/95 backdrop-blur-md border-t border-slate-800 p-4 z-30">
        <div class="max-w-2xl mx-auto flex gap-3">
          <button type="button" onclick="fecharModalOS()"
            class="w-1/3 py-3.5 px-4 bg-[#1e293b] hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-sm">
            Cancelar
          </button>
          <button type="submit"
            class="w-2/3 py-3.5 px-4 bg-[#10b981] hover:bg-emerald-400 active:bg-emerald-600 text-slate-950 font-bold rounded-xl shadow-lg shadow-emerald-600/20 text-sm flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Salvar Ordem de Serviço</span>
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- =====================================================================
       4. TOAST DE NOTIFICAÇÃO (SUBSTITUI ALERT)
       ===================================================================== -->
  <div id="toast" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 hidden px-4 py-2.5 rounded-full bg-slate-800 border border-slate-700 text-white text-xs font-semibold shadow-2xl flex items-center gap-2 whitespace-nowrap">
    <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
    <span id="toast-msg">Salvo com sucesso!</span>
  </div>

  <!-- =====================================================================
       LÓGICA JAVASCRIPT UNIFICADA
       ===================================================================== -->
  <script>
    const STORAGE_KEY = 'spc_ordens_servico_v2';
    const USER_KEY = 'spc_usuario_ativo_v2';

    let filtroStatusAtual = 'Todas';
    let statusModalAtual = 'Aberta';
    let itensModalAtual = [];
    let temAssinatura = false;

    // Dados iniciais realistas caso o localStorage esteja vazio
    const DADOS_INICIAIS = [
      {
        id: 'OS-2026-001',
        data: '19/11/2026',
        cliente: 'Condomínio Residencial Alvorada',
        telefone: '(61) 98455-1234',
        subsistema: 'Interfonia / Intelbras',
        descricao: 'Configuração de ramais na Central Intelbras CP48 e troca de placa de tronco.',
        status: 'Em Andamento',
        tecnico: 'Carlos Técnico',
        itens: [
          { desc: 'Placa Tronco Intelbras CP48', valor: 280.00 },
          { desc: 'Mão de Obra Técnica Especializada', valor: 180.00 }
        ],
        assinatura: null
      },
      {
        id: 'OS-2026-002',
        data: '18/11/2026',
        cliente: 'Edifício Comercial Horizonte',
        telefone: '(61) 99122-8877',
        subsistema: 'CFTV (Câmeras / DVR)',
        descricao: 'Câmeras da garagem G1 sem imagem. Substituição de fonte colmeia 12V 10A e conectores BNC.',
        status: 'Concluída',
        tecnico: 'Carlos Técnico',
        itens: [
          { desc: 'Fonte Colmeia 12V 10A', valor: 95.00 },
          { desc: 'Kit 4 Conectores BNC + P4', valor: 35.00 },
          { desc: 'Visita Técnica e Reparo', valor: 150.00 }
        ],
        assinatura: null
      },
      {
        id: 'OS-2026-003',
        data: '19/11/2026',
        cliente: 'Residência Sr. Roberto Martins',
        telefone: '(61) 98111-4590',
        subsistema: 'Automatizador de Portão',
        descricao: 'Portão deslizante PPA travando no fim de curso. Necessário ajustar ímãs e lubrificar cremalheira.',
        status: 'Aberta',
        tecnico: 'Carlos Técnico',
        itens: [
          { desc: 'Sensor Fim de Curso + Ímãs', valor: 45.00 },
          { desc: 'Manutenção Preventiva Motor', valor: 140.00 }
        ],
        assinatura: null
      }
    ];

    // -----------------------------------------------------------------------
    // INICIALIZAÇÃO E PERSISTÊNCIA
    // -----------------------------------------------------------------------
    window.addEventListener('DOMContentLoaded', () => {
      if (!localStorage.getItem(STORAGE_KEY)) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(DADOS_INICIAIS));
      }

      // Verifica se já existe sessão ativa
      const usuarioSalvo = localStorage.getItem(USER_KEY);
      if (usuarioSalvo) {
        const user = JSON.parse(usuarioSalvo);
        entrarNoPainel(user.nome, user.perfil);
      }

      inicializarCanvasAssinatura();
    });

    function getListaOS() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch (e) {
        return [];
      }
    }

    function salvarListaOS(lista) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(lista));
    }

    function mostrarToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2800);
    }

    function formatarMoeda(valor) {
      return Number(valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    // -----------------------------------------------------------------------
    // 1. LÓGICA DE LOGIN
    // -----------------------------------------------------------------------
    let perfilSelecionado = 'tecnico';

    function selecionarPerfil(perfil) {
      perfilSelecionado = perfil;
      const btnTech = document.getElementById('btn-role-tech');
      const btnAdmin = document.getElementById('btn-role-admin');
      const userInput = document.getElementById('login-user');
      const passInput = document.getElementById('login-pass');

      if (perfil === 'tecnico') {
        btnTech.className = "flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all bg-[#2563eb] text-white shadow";
        btnAdmin.className = "flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all text-slate-400 hover:text-white";
        userInput.value = 'Carlos Técnico';
        passInput.value = '123456';
      } else {
        btnAdmin.className = "flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all bg-[#2563eb] text-white shadow";
        btnTech.className = "flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold transition-all text-slate-400 hover:text-white";
        userInput.value = 'Marcos Admin';
        passInput.value = 'admin123';
      }
    }

    function toggleSenha() {
      const input = document.getElementById('login-pass');
      input.type = input.type === 'password' ? 'text' : 'password';
    }

    function fazerLogin(e) {
      e.preventDefault();
      const nome = document.getElementById('login-user').value.trim();
      const senha = document.getElementById('login-pass').value.trim();
      const errBox = document.getElementById('login-error');

      if (!nome || !senha) {
        errBox.classList.remove('hidden');
        return;
      }
      errBox.classList.add('hidden');

      const isAdmin = nome.toLowerCase().includes('admin') || perfilSelecionado === 'admin';
      const perfilLabel = isAdmin ? 'Administrador' : 'Técnico';

      localStorage.setItem(USER_KEY, JSON.stringify({ nome, perfil: perfilLabel }));
      entrarNoPainel(nome, perfilLabel);
    }

    function entrarNoPainel(nome, perfil) {
      document.getElementById('header-user-name').textContent = nome;
      const badge = document.getElementById('header-user-badge');
      badge.textContent = perfil;
      if (perfil === 'Administrador') {
        badge.className = "text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 border border-amber-500/30";
      } else {
        badge.className = "text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-400 border border-blue-500/30";
      }

      document.getElementById('login-view').classList.add('hidden');
      document.getElementById('app-view').classList.remove('hidden');
      renderizarListaOS();
    }

    function sairApp() {
      localStorage.removeItem(USER_KEY);
      document.getElementById('app-view').classList.add('hidden');
      document.getElementById('login-view').classList.remove('hidden');
    }

    // -----------------------------------------------------------------------
    // 2. PAINEL PRINCIPAL & FILTROS
    // -----------------------------------------------------------------------
    function setFiltroStatus(status) {
      filtroStatusAtual = status;
      document.querySelectorAll('.filter-pill').forEach(btn => {
        if (btn.dataset.filter === status) {
          btn.className = "filter-pill px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-[#2563eb] text-white";
        } else {
          btn.className = "filter-pill px-3.5 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all bg-[#1e293b] text-slate-300 hover:bg-slate-700";
        }
      });
      renderizarListaOS();
    }

    function calcularTotalOS(os) {
      if (!os.itens || !Array.isArray(os.itens)) return 0;
      return os.itens.reduce((acc, item) => acc + (parseFloat(item.valor) || 0), 0);
    }

    function renderizarListaOS() {
      const lista = getListaOS();
      const termo = document.getElementById('search-input').value.toLowerCase().trim();

      // Atualiza Estatísticas Gerais
      let abertas = 0, andamento = 0, concluidas = 0, faturamento = 0;
      lista.forEach(os => {
        const total = calcularTotalOS(os);
        if (os.status === 'Aberta') abertas++;
        else if (os.status === 'Em Andamento') andamento++;
        else if (os.status === 'Concluída') {
          concluidas++;
          faturamento += total;
        }
      });

      document.getElementById('stat-abertas').textContent = abertas;
      document.getElementById('stat-andamento').textContent = andamento;
      document.getElementById('stat-concluidas').textContent = concluidas;
      document.getElementById('stat-faturamento').textContent = formatarMoeda(faturamento);

      // Filtra lista
      const filtrada = lista.filter(os => {
        const matchStatus = filtroStatusAtual === 'Todas' || os.status === filtroStatusAtual;
        const matchTexto = !termo ||
          os.cliente.toLowerCase().includes(termo) ||
          os.id.toLowerCase().includes(termo) ||
          os.subsistema.toLowerCase().includes(termo) ||
          os.descricao.toLowerCase().includes(termo) ||
          (os.telefone && os.telefone.includes(termo));
        return matchStatus && matchTexto;
      });

      const container = document.getElementById('os-list-container');
      if (filtrada.length === 0) {
        container.innerHTML = `
          <div class="bg-[#111827] border border-slate-800 rounded-2xl p-8 text-center">
            <p class="text-slate-400 text-sm">Nenhuma Ordem de Serviço encontrada.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtrada.map(os => {
        const total = calcularTotalOS(os);
        let badgeStyle = 'bg-amber-500/15 text-amber-400 border-amber-500/30';
        if (os.status === 'Em Andamento') badgeStyle = 'bg-blue-500/15 text-blue-400 border-blue-500/30';
        if (os.status === 'Concluída') badgeStyle = 'bg-[#10b981]/15 text-[#10b981] border-[#10b981]/30';

        return `
          <article onclick="abrirModalEditarOS('${os.id}')"
            class="bg-[#1e293b]/70 hover:bg-[#1e293b] active:scale-[0.99] border border-slate-800 rounded-2xl p-4 transition-all cursor-pointer space-y-2.5 shadow-sm">
            
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-md border border-blue-500/20">${os.id}</span>
                <span class="text-xs text-slate-400">${os.data}</span>
              </div>
              <span class="text-xs font-bold px-2.5 py-1 rounded-full border ${badgeStyle}">${os.status}</span>
            </div>

            <div>
              <h3 class="text-base font-bold text-white leading-snug">${os.cliente}</h3>
              <p class="text-xs font-medium text-slate-300 mt-0.5 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#2563eb]"></span>
                ${os.subsistema}
              </p>
            </div>

            <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">${os.descricao}</p>

            <div class="pt-2.5 border-t border-slate-700/60 flex items-center justify-between">
              <div class="flex items-center gap-2 text-xs text-slate-400">
                <span>${os.telefone || 'Sem telefone'}</span>
                ${os.assinatura ? '<span class="text-[#10b981] font-semibold">• Assinada ✓</span>' : ''}
              </div>
              <span class="text-sm font-bold text-white">${formatarMoeda(total)}</span>
            </div>
          </article>
        `;
      }).join('');
    }

    // -----------------------------------------------------------------------
    // 3. MODAL DE CRIAÇÃO / EDIÇÃO DE O.S.
    // -----------------------------------------------------------------------
    function selecionarStatusModal(status) {
      statusModalAtual = status;
      document.querySelectorAll('.modal-status-btn').forEach(btn => {
        const s = btn.dataset.modalStatus;
        if (s === status) {
          if (s === 'Aberta') btn.className = "modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-amber-500/20 border-amber-500 text-amber-300";
          if (s === 'Em Andamento') btn.className = "modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-[#2563eb]/25 border-[#2563eb] text-blue-300";
          if (s === 'Concluída') btn.className = "modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-[#10b981]/20 border-[#10b981] text-[#10b981]";
        } else {
          btn.className = "modal-status-btn py-2.5 px-2 rounded-xl text-xs font-bold border transition-all text-center bg-[#0b1120] border-slate-800 text-slate-400";
        }
      });
    }

    function abrirModalNovaOS() {
      document.getElementById('modal-title').textContent = 'Nova Ordem de Serviço';
      document.getElementById('os-id').value = '';
      document.getElementById('os-cliente').value = '';
      document.getElementById('os-telefone').value = '';
      document.getElementById('os-subsistema').value = 'CFTV (Câmeras / DVR)';
      document.getElementById('os-descricao').value = '';
      document.getElementById('btn-delete-os').classList.add('hidden');
      document.getElementById('delete-confirm-box').classList.add('hidden');

      selecionarStatusModal('Aberta');
      itensModalAtual = [{ desc: 'Visita Técnica / Avaliação', valor: 120 }];
      renderizarItensModal();

      limparAssinatura();
      document.getElementById('os-modal').classList.remove('hidden');
      setTimeout(redimensionarCanvas, 50);
    }

    function abrirModalEditarOS(id) {
      const lista = getListaOS();
      const os = lista.find(item => item.id === id);
      if (!os) return;

      document.getElementById('modal-title').textContent = `Editar ${os.id}`;
      document.getElementById('os-id').value = os.id;
      document.getElementById('os-cliente').value = os.cliente;
      document.getElementById('os-telefone').value = os.telefone || '';
      document.getElementById('os-subsistema').value = os.subsistema;
      document.getElementById('os-descricao').value = os.descricao;
      document.getElementById('btn-delete-os').classList.remove('hidden');
      document.getElementById('delete-confirm-box').classList.add('hidden');

      selecionarStatusModal(os.status);
      itensModalAtual = os.itens && os.itens.length ? JSON.parse(JSON.stringify(os.itens)) : [];
      renderizarItensModal();

      document.getElementById('os-modal').classList.remove('hidden');
      setTimeout(() => {
        redimensionarCanvas();
        limparAssinatura();
        if (os.assinatura) {
          carregarAssinaturaNoCanvas(os.assinatura);
        }
      }, 50);
    }

    function fecharModalOS() {
      document.getElementById('os-modal').classList.add('hidden');
    }

    // Gerenciamento Dinâmico de Itens/Peças
    function adicionarItemOS() {
      itensModalAtual.push({ desc: '', valor: '' });
      renderizarItensModal();
    }

    function removerItemOS(index) {
      itensModalAtual.splice(index, 1);
      renderizarItensModal();
    }

    function atualizarItemOS(index, campo, valor) {
      itensModalAtual[index][campo] = campo === 'valor' ? (parseFloat(valor) || 0) : valor;
      atualizarTotalModal();
    }

    function atualizarTotalModal() {
      const total = itensModalAtual.reduce((acc, item) => acc + (parseFloat(item.valor) || 0), 0);
      document.getElementById('os-total-display').textContent = formatarMoeda(total);
    }

    function renderizarItensModal() {
      const container = document.getElementById('os-itens-list');
      if (itensModalAtual.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-500 text-center py-2">Nenhum item ou peça adicionado.</p>`;
        atualizarTotalModal();
        return;
      }

      container.innerHTML = itensModalAtual.map((item, idx) => `
        <div class="flex items-center gap-2">
          <input type="text" value="${item.desc}" oninput="atualizarItemOS(${idx}, 'desc', this.value)"
            class="flex-1 px-3 py-2.5 bg-[#0b1120] border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-[#2563eb]"
            placeholder="Peça ou serviço (ex: Câmera HD)" />
          <input type="number" step="0.01" value="${item.valor}" oninput="atualizarItemOS(${idx}, 'valor', this.value)"
            class="w-24 px-3 py-2.5 bg-[#0b1120] border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-[#2563eb]"
            placeholder="R$ 0,00" />
          <button type="button" onclick="removerItemOS(${idx})" class="p-2.5 rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      `).join('');

      atualizarTotalModal();
    }

    function salvarOS(e) {
      e.preventDefault();
      const idExistente = document.getElementById('os-id').value;
      const cliente = document.getElementById('os-cliente').value.trim();
      const telefone = document.getElementById('os-telefone').value.trim();
      const subsistema = document.getElementById('os-subsistema').value;
      const descricao = document.getElementById('os-descricao').value.trim();

      const itensValidos = itensModalAtual.filter(i => i.desc.trim() !== '' || (parseFloat(i.valor) || 0) > 0);
      const canvas = document.getElementById('signature-canvas');
      const assinaturaData = temAssinatura ? canvas.toDataURL('image/png') : null;

      const lista = getListaOS();
      const user = JSON.parse(localStorage.getItem(USER_KEY) || '{"nome":"Técnico"}');

      if (idExistente) {
        const idx = lista.findIndex(o => o.id === idExistente);
        if (idx !== -1) {
          lista[idx] = {
            ...lista[idx],
            cliente,
            telefone,
            subsistema,
            descricao,
            status: statusModalAtual,
            itens: itensValidos,
            assinatura: assinaturaData
          };
        }
        mostrarToast(`${idExistente} atualizada!`);
      } else {
        const proximoNum = String(lista.length + 1).padStart(3, '0');
        const novoId = `OS-2026-${proximoNum}`;
        const hoje = new Date().toLocaleDateString('pt-BR');
        lista.unshift({
          id: novoId,
          data: hoje,
          cliente,
          telefone,
          subsistema,
          descricao,
          status: statusModalAtual,
          tecnico: user.nome,
          itens: itensValidos,
          assinatura: assinaturaData
        });
        mostrarToast(`${novoId} criada com sucesso!`);
      }

      salvarListaOS(lista);
      fecharModalOS();
      renderizarListaOS();
    }

    // Exclusão Segura
    function confirmarExclusao() {
      document.getElementById('delete-confirm-box').classList.remove('hidden');
    }
    function cancelarExclusao() {
      document.getElementById('delete-confirm-box').classList.add('hidden');
    }
    function executarExclusao() {
      const id = document.getElementById('os-id').value;
      const lista = getListaOS().filter(o => o.id !== id);
      salvarListaOS(lista);
      fecharModalOS();
      renderizarListaOS();
      mostrarToast('Ordem de Serviço excluída.');
    }

    // -----------------------------------------------------------------------
    // 4. ASSINATURA DIGITAL TOUCHSCREEN (CANVAS)
    // -----------------------------------------------------------------------
    let desenhando = false;
    let ctxAssinatura = null;

    function inicializarCanvasAssinatura() {
      const canvas = document.getElementById('signature-canvas');
      ctxAssinatura = canvas.getContext('2d');

      const getPos = (e) => {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return {
          x: clientX - rect.left,
          y: clientY - rect.top
        };
      };

      const iniciarDesenho = (e) => {
        desenhando = true;
        temAssinatura = true;
        document.getElementById('signature-placeholder').classList.add('hidden');
        const pos = getPos(e);
        ctxAssinatura.beginPath();
        ctxAssinatura.moveTo(pos.x, pos.y);
      };

      const moverDesenho = (e) => {
        if (!desenhando) return;
        e.preventDefault();
        const pos = getPos(e);
        ctxAssinatura.lineTo(pos.x, pos.y);
        ctxAssinatura.strokeStyle = '#38bdf8';
        ctxAssinatura.lineWidth = 2.5;
        ctxAssinatura.lineCap = 'round';
        ctxAssinatura.lineJoin = 'round';
        ctxAssinatura.stroke();
      };

      const pararDesenho = () => {
        desenhando = false;
      };

      // Eventos de Mouse
      canvas.addEventListener('mousedown', iniciarDesenho);
      canvas.addEventListener('mousemove', moverDesenho);
      window.addEventListener('mouseup', pararDesenho);

      // Eventos de Toque (Mobile)
      canvas.addEventListener('touchstart', iniciarDesenho, { passive: false });
      canvas.addEventListener('touchmove', moverDesenho, { passive: false });
      canvas.addEventListener('touchend', pararDesenho);
    }

    function redimensionarCanvas() {
      const canvas = document.getElementById('signature-canvas');
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
    }

    function limparAssinatura() {
      const canvas = document.getElementById('signature-canvas');
      if (ctxAssinatura) {
        ctxAssinatura.clearRect(0, 0, canvas.width, canvas.height);
      }
      temAssinatura = false;
      document.getElementById('signature-placeholder').classList.remove('hidden');
    }

    function carregarAssinaturaNoCanvas(dataUrl) {
      const canvas = document.getElementById('signature-canvas');
      const img = new Image();
      img.onload = () => {
        ctxAssinatura.drawImage(img, 0, 0);
        temAssinatura = true;
        document.getElementById('signature-placeholder').classList.add('hidden');
      };
      img.src = dataUrl;
    }
  </script>
</body>
</html>